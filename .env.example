# Copy to .env.local (dev) or .env (Docker) and fill in.
# No quotes, no spaces around `=` — docker compose passes values through literally.
SUPABASE_URL=https://qmaphtslnvvifkzmbrvh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Basic Auth (src/middleware.ts). REQUIRED in production: with either value
# unset, a production build answers every request with 503 rather than serving
# the dashboard unauthenticated. Ignored by `npm run dev`.
BASIC_AUTH_USER=korefi
BASIC_AUTH_PASS=
