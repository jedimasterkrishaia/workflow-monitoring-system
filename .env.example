# Copy to .env.local (dev) or .env (Docker) and fill in.
# No quotes, no spaces around `=` — docker compose passes values through literally.
SUPABASE_URL=https://qmaphtslnvvifkzmbrvh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Traefik routing (docker-compose.yml labels) ---
# Domain the dashboard is served on.
#
# Default uses sslip.io, which resolves <anything>.<ip>.sslip.io to <ip> with no
# DNS records to create — so the ACME HTTP-01 challenge works on a fresh VPS.
# The embedded IP is the VPS's: change it if the server moves.
MONITOR_DOMAIN=monitor.187.127.173.25.sslip.io
# For a real domain instead, point its A record at the VPS *before* the first
# `up` (or the ACME challenge fails and Traefik serves its self-signed cert):
# MONITOR_DOMAIN=monitor.aiaccountant.com

# These three must match the running Traefik install's entrypoint/resolver
# names (its `--entrypoints.*` and `--certificatesresolvers.*` flags or
# static config) — not a network name. This Traefik runs with
# `network_mode: host` and discovers containers over the Docker socket
# (`providers.docker`), so no shared docker network is needed here at all.
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
